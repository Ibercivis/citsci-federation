{
  "name": "citsci-federation",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "broker:up": "docker compose up -d --wait --build",
    "broker:down": "docker compose --profile \"*\" down -v --remove-orphans",
    "broker:logs": "docker compose logs -f keycloak",
    "broker:reset": "docker compose --profile \"*\" down -v --remove-orphans && docker compose up -d --wait --build",
    "apps:up": "./scripts/apps-up.sh",
    "apps:down": "docker compose -f compose.yaml -f compose.apps.yaml down",
    "apps:logs": "docker compose -f compose.yaml -f compose.apps.yaml logs -f",
    "apps:reset": "./scripts/apps-up.sh --reset",
    "clean-slate": "./scripts/clean-slate.sh",
    "sign-in-url": "./scripts/sign-in-url.sh",
    "persons": "./scripts/persons.sh",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "require-issue-link:check": "./scripts/check-require-issue-link.sh",
    "reuse:lint": "./scripts/reuse-lint.sh",
    "demo-services:check": "./scripts/check-demo-services.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm require-issue-link:check && pnpm reuse:lint && pnpm demo-services:check",
    "check:fix": "pnpm format && pnpm lint:fix",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "jose": "6.2.18",
    "oidc-provider": "9.15.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
