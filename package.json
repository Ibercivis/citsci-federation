{
  "name": "citsci-federation",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "broker:up": "docker compose up -d --wait",
    "broker:down": "docker compose down -v",
    "broker:logs": "docker compose logs -f keycloak",
    "broker:reset": "docker compose down -v && docker compose up -d --wait",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "reuse:lint": "docker run --rm --user \"$(id -u):$(id -g)\" --volume \"$PWD:/data\" fsfe/reuse:6.3.0@sha256:2748d04c2adeb747c9a44831bc99a9cbfd7bf7ff6fc371a4b63204944e3e47b6 lint",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm reuse:lint",
    "check:fix": "pnpm format && pnpm lint:fix",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
