# Internal operational notes. Never committed: this repo is public.
# See AGENTS.md > Internal notes.
docs/private/

node_modules/

# macOS Finder's per-directory metadata. It appears in any folder somebody
# opens and says nothing about this project.
.DS_Store

# The tracked .env holds the development stack's constants, which are not
# worth protecting. A local override carrying anything that is stays out of
# a public repository.
.env.local

# Browser-automation leftovers: screenshots and traces of running applications,
# which may hold personal data and must not reach a public repository.
.playwright-mcp/
test-results/
playwright-report/

# The Keycloak extensions' build output, if either is ever built outside the
# image.
broker/person-identifier/target/
broker/verified-email/target/

# The Brokered Apps' own repositories, checked out at their `federation`
# branch by scripts/checkout-apps.sh so that the Brokered Composition can
# build them. No application's code is vendored here: this folder is a working
# copy and is rebuilt from the remotes by that script (ADR-0009).
apps/

# An agent's worktrees, one per task given an isolated checkout. Each holds a
# second copy of this repository with its dependencies installed, and every
# tool that walks the tree reads them: `pnpm lint` stops on the lint config
# inside one, `pnpm reuse:lint` on a dependency's licence, and `pnpm check`
# fails for a reason that has nothing to do with the branch being pushed.
# A worktree commits on its own branch, never through this checkout.
.claude/worktrees/
