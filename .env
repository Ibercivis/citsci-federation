# The declared development stack's configuration. Compose reads this file on
# its own, and so does the test harness.
#
# Every value here is a development constant on purpose: this stack is meant
# to be thrown away and recreated, and a secret worth protecting has no
# business being reproducible from a file in a public repository. There is no
# such secret yet. When the first one arrives — the Google and GitHub client
# secrets — it is referenced and not declared: `${NAME}` in
# broker/realm/, and the value in `.env.local`, which is gitignored
# and which compose.yaml hands to the Broker. The name goes in the realm
# rather than here, because this file is tracked and that one is not.
#
# So nothing is added here for a credential, and nothing in this repository
# holds one today.

# The Broker's issuer, declared once and read from here by everything that
# needs it (ADR-0001). It is never persisted in any database and it is never
# reconstructed by concatenating parts: this string is the configuration, and
# what Keycloak is told is derived from it rather than assembled beside it.
#
# `/realms/<name>` stays in the path on purpose (ADR-0001). The name has to
# match the realm this repository declares in broker/realm/base.json, and
# the discovery case says so out loud when it does not.
#
# One name on both sides of the port mapping. `broker.localhost` is the
# loopback address for a browser (RFC 6761, honoured by macOS and by every
# browser) and, through a network alias on the reverse proxy, this stack from
# inside the compose network. Pinning it to `localhost` instead would leave
# anything running in a container unable to reach the issuer it is told to
# trust, because localhost inside a container is the container.
#
# The one trap, measured in the earlier effort: musl resolves anything under
# .localhost to the loopback itself and never asks Docker's DNS, so an
# Alpine-based Brokered App container would find itself rather than the
# Broker. If some image ever has to be musl, the fallback is a name outside
# .localhost — broker.federation.test resolves under both libcs — plus one
# /etc/hosts line on the host for the browser.
BROKER_ISSUER=http://broker.localhost:8080/realms/citsci

# The Mock Identity Source's issuer: a test source this repository runs
# itself (mock-source/). Same trick as above, a name under .localhost
# that a browser resolves to the loopback and the compose network to the
# source's own container — the Broker reaches it from inside the network to
# redeem codes, fetch keys and call userinfo, and a Person's browser reaches it
# from outside to sign in. Its alpine image is musl, which is safe here
# because it never calls a .localhost name itself.
MOCK_ISSUER=http://mock.localhost:8090

# Which Broker this stack is: `testing`, the base declaration plus the testing
# layer (the `demo` Identity, the Mock Identity Sources, the stand-in clients and
# `misconfigured-client`) with the Mock Identity Source running; or `production`, the base alone. The
# development stack and CI run `testing`. Anything else stops the image build.
# broker/README.md says which layer an addition belongs in.
#
# Set it in the shell to override this file for one command:
#   BROKER_MODE=production pnpm broker:reset
BROKER_MODE=testing

# Derived from the line above, never set by hand: it is how compose starts the
# Mock Identity Source only in `testing`. The `production` profile names no
# service, so it starts only the base.
COMPOSE_PROFILES=${BROKER_MODE}

# Where the Broker sends its mail: the mail catcher compose.yaml runs in
# `testing`. A `production` stack here has no catcher, so its mail goes
# nowhere; it starts all the same, because Keycloak opens the connection only
# to send. A real deployment names its own server.
SMTP_HOST=mailpit
SMTP_PORT=1025

# ---------------------------------------------------------------------------
# The Pilot Composition's Brokered Apps (compose.pilot.yaml, ADR-0009)
# ---------------------------------------------------------------------------
#
# Three values per application, declared here and read from here by all three
# of the places that need them: the reverse proxy (which serves the hostname),
# the realm import (which registers the client under that name and secret) and
# the application's own container (which is told the Broker's address, its
# client id and its secret as configuration, ADR-0001).
#
# Every address is a name under `.localhost`, as the Broker's own is above and
# for the same reason: a browser resolves it to the loopback without an
# /etc/hosts line, and nothing is reached by a port on this machine. An
# application that is not up answers 502 through the proxy, which says which
# application is missing rather than nothing at all.
#
# The secrets are development constants, like every other value in this file.
# The realm references each one by name — `${LOSTATNIGHT_CLIENT_SECRET}` in
# broker/realm-citsci.json — so an installation that wants a real one changes
# it here and nowhere else.

# LostAtNight — Ibercivis/gdalface. A server-rendered Django site, so this one
# address is the whole application.
LOSTATNIGHT_BASE_URL=http://lostatnight.localhost:8080
LOSTATNIGHT_CLIENT_ID=lostatnight
LOSTATNIGHT_CLIENT_SECRET=lostatnight-development-secret

# Geonity — Ibercivis/citsci-api (the API) and Ibercivis/Geonity (the web app
# and the admin panel). Three addresses, one client: the Broker registers the
# application, and the API is the part of it that holds the secret.
GEONITY_API_BASE_URL=http://geonity-api.localhost:8080
GEONITY_WEB_BASE_URL=http://geonity.localhost:8080
GEONITY_ADMIN_BASE_URL=http://geonity-admin.localhost:8080
GEONITY_CLIENT_ID=geonity
GEONITY_CLIENT_SECRET=geonity-development-secret

# OpenRed — Ibercivis/OpenRed (the API). `openred.localhost` is declared and
# not served: it is the address its React front end takes when that front end
# joins the composition (`issue #96`), so the API does not have to be renamed
# that day. The API is told it already, because that is where its mail links
# send a Person — the links resolve when something answers there, and until
# then the proxy says it serves no such name.
OPENRED_API_BASE_URL=http://openred-api.localhost:8080
OPENRED_WEB_BASE_URL=http://openred.localhost:8080
OPENRED_CLIENT_ID=openred
OPENRED_CLIENT_SECRET=openred-development-secret

# The mail catcher's inbox: where every message any of them sends arrives, and
# where the tests read the Broker's own mail. Every application in the
# composition keeps email verification mandatory, as production does, so a
# sign-up cannot be finished without reading the message — and nothing in the
# composition can deliver one to a real address. No port of its own: this
# address is served through the proxy, and compose.yaml says why.
MAIL_BASE_URL=http://mail.localhost:8080
