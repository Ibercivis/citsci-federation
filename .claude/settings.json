{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm check *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm format:check)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm reuse:lint)",
      "Bash(pnpm reuse:lint *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm vitest run)",
      "Bash(pnpm vitest run *)",
      "Bash(./scripts/check-repeated-prose.sh)",
      "Bash(./scripts/check-repeated-prose.sh *)",
      "Bash(scripts/check-repeated-prose.sh)",
      "Bash(scripts/check-repeated-prose.sh *)",
      "Bash(./scripts/check-require-issue-link.sh)",
      "Bash(scripts/check-require-issue-link.sh)",
      "Bash(./scripts/check-foreign-vocabulary.sh *)",
      "Bash(scripts/check-foreign-vocabulary.sh *)",
      "Bash(./scripts/check-pr-metadata.sh *)",
      "Bash(scripts/check-pr-metadata.sh *)",
      "Bash(./scripts/check-private.sh)",
      "Bash(scripts/check-private.sh)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose ls)",
      "Bash(docker compose ls *)",
      "Bash(docker volume ls)",
      "Bash(docker volume ls *)",
      "Bash(gh label list)",
      "Bash(gh label list *)",
      "Bash(gh run watch *)",
      "Bash(javap *)"
    ],
    "deny": ["Artifact", "ArtifactComments", "ArtifactData"]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/private-sync.sh pull",
            "timeout": 30,
            "statusMessage": "Syncing internal notes"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claim-issue.sh",
            "timeout": 20,
            "statusMessage": "Claiming the branch's issue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/require-issue-link.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/ask-before-reading-a-note.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claim-issue.sh",
            "timeout": 20,
            "statusMessage": "Claiming the branch's issue"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/private-sync.sh push",
            "timeout": 60,
            "statusMessage": "Recording internal notes"
          }
        ]
      }
    ]
  }
}
