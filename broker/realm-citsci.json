{
  "realm": "citsci",
  "enabled": true,
  "displayName": "Ibercivis Citizen Science",
  "loginWithEmailAllowed": true,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "brokered-app-public",
      "name": "Brokered App (public)",
      "description": "A single-page application. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "brokered-app-public",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": []
    },
    {
      "clientId": "brokered-app-confidential",
      "name": "Brokered App (confidential)",
      "description": "A server-rendered backend. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "brokered-app-confidential",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": [],
      "clientAuthenticatorType": "client-secret",
      "secret": "brokered-app-confidential-development-secret"
    },
    {
      "clientId": "misconfigured-client",
      "name": "Misconfigured client",
      "description": "Testing only: see MISCONFIGURED_CLIENT in tests/clients.ts.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": [],
      "attributes": {},
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "mock",
      "displayName": "Mock source (not for launch)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "issuer": "${MOCK_ISSUER}",
        "authorizationUrl": "${MOCK_ISSUER}/auth",
        "tokenUrl": "${MOCK_ISSUER}/token",
        "userInfoUrl": "${MOCK_ISSUER}/me",
        "jwksUrl": "${MOCK_ISSUER}/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "clientId": "citsci-broker",
        "clientSecret": "mock-source-development-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "code-flow-only",
        "description": "What every client is held to, whatever its own settings say.",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": { "auto-configure": "false" }
          },
          {
            "executor": "reject-implicit-grant",
            "configuration": { "auto-configure": "false" }
          },
          { "executor": "secure-session", "configuration": {} }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "code-flow-only",
        "description": "Applies the code-flow-only profile to every client.",
        "enabled": true,
        "conditions": [{ "condition": "any-client", "configuration": {} }],
        "profiles": ["code-flow-only"]
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.org",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo"
        }
      ]
    }
  ]
}
