{
  "clients": [
    {
      "clientId": "misconfigured-client",
      "name": "Misconfigured client",
      "description": "Testing only: see MISCONFIGURED_CLIENT in tests/clients.ts.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": [],
      "attributes": {},
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "mock",
      "displayName": "Mock source (not for launch)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "issuer": "${MOCK_ISSUER}",
        "authorizationUrl": "${MOCK_ISSUER}/auth",
        "tokenUrl": "${MOCK_ISSUER}/token",
        "userInfoUrl": "${MOCK_ISSUER}/me",
        "jwksUrl": "${MOCK_ISSUER}/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "clientId": "citsci-broker",
        "clientSecret": "mock-source-development-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "mock-affirming-a",
      "displayName": "Mock source A, affirms addresses (not for launch)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "issuer": "${MOCK_ISSUER}",
        "authorizationUrl": "${MOCK_ISSUER}/auth",
        "tokenUrl": "${MOCK_ISSUER}/token",
        "userInfoUrl": "${MOCK_ISSUER}/me",
        "jwksUrl": "${MOCK_ISSUER}/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "clientId": "citsci-broker",
        "clientSecret": "mock-source-development-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "mock-affirming-b",
      "displayName": "Mock source B, affirms addresses (not for launch)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "issuer": "${MOCK_ISSUER}",
        "authorizationUrl": "${MOCK_ISSUER}/auth",
        "tokenUrl": "${MOCK_ISSUER}/token",
        "userInfoUrl": "${MOCK_ISSUER}/me",
        "jwksUrl": "${MOCK_ISSUER}/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "clientId": "citsci-broker",
        "clientSecret": "mock-source-development-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.org",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo"
        }
      ]
    }
  ]
}
