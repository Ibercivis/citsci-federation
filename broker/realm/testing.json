{
  "clients": [
    {
      "clientId": "brokered-app-public",
      "name": "Brokered App (public)",
      "description": "A single-page application. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "brokered-app-public",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": []
    },
    {
      "clientId": "brokered-app-confidential",
      "name": "Brokered App (confidential)",
      "description": "A server-rendered backend. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:8000/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "brokered-app-confidential",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": [],
      "clientAuthenticatorType": "client-secret",
      "secret": "brokered-app-confidential-development-secret"
    },
    {
      "clientId": "misconfigured-client",
      "name": "Misconfigured client",
      "description": "Testing only: see MISCONFIGURED_CLIENT in tests/clients.ts.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["http://localhost:3001/*"],
      "webOrigins": [],
      "attributes": {},
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": []
    }
  ],
  "identityProviders": [
    {
      "alias": "mock-identity-source",
      "displayName": "Mock Identity Source (not for launch)",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "config": {
        "issuer": "${MOCK_IDENTITY_SOURCE_ISSUER}",
        "authorizationUrl": "${MOCK_IDENTITY_SOURCE_ISSUER}/auth",
        "tokenUrl": "${MOCK_IDENTITY_SOURCE_ISSUER}/token",
        "userInfoUrl": "${MOCK_IDENTITY_SOURCE_ISSUER}/me",
        "jwksUrl": "${MOCK_IDENTITY_SOURCE_ISSUER}/jwks",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "clientId": "citsci-broker",
        "clientSecret": "mock-identity-source-development-secret",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid email",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "syncMode": "IMPORT"
      }
    },
    {
