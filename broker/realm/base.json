{
  "realm": "citsci",
  "enabled": true,
  "displayName": "Ibercivis Citizen Science",
  "loginWithEmailAllowed": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "passwordPolicy": "length(12)",
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "no-reply@ibercivis.es",
    "fromDisplayName": "Ibercivis Citizen Science"
  },
  "firstBrokerLoginFlow": "citsci first broker login",
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_EMAIL",
      "name": "Update Email",
      "providerId": "UPDATE_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    }
  ],
  "clients": [
    {
      "clientId": "${LOSTATNIGHT_CLIENT_ID}",
      "name": "LostAtNight",
      "description": "A Brokered App of the Pilot Composition: Ibercivis/gdalface, on its federation branch. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["${LOSTATNIGHT_BASE_URL}/accounts/oidc/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${LOSTATNIGHT_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": [],
      "clientAuthenticatorType": "client-secret",
      "secret": "${LOSTATNIGHT_CLIENT_SECRET}"
    },
    {
      "clientId": "${GEONITY_CLIENT_ID}",
      "name": "Geonity",
      "description": "A Brokered App of the Pilot Composition: Ibercivis/citsci-api, on its federation branch. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["${GEONITY_API_BASE_URL}/accounts/oidc/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${GEONITY_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": [],
      "clientAuthenticatorType": "client-secret",
      "secret": "${GEONITY_CLIENT_SECRET}"
    },
    {
      "clientId": "${OPENRED_CLIENT_ID}",
      "name": "OpenRed",
      "description": "A Brokered App of the Pilot Composition: Ibercivis/OpenRed, on its federation branch. The consent screen names it.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "redirectUris": ["${OPENRED_API_BASE_URL}/accounts/oidc/*"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "sub",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "voperson_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-person-identifier-mapper",
          "config": {
            "person.identifier.scope": "ibercivis.es",
            "claim.name": "voperson_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "${OPENRED_CLIENT_ID}",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": ["acr", "basic", "email", "web-origins"],
      "optionalClientScopes": [],
      "clientAuthenticatorType": "client-secret",
      "secret": "${OPENRED_CLIENT_SECRET}"
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "citsci-review-what-is-missing",
      "config": {
        "update.profile.on.first.login": "missing"
      }
    },
    {
      "alias": "citsci-refuse-an-unverified-join",
      "config": {
        "denyErrorMessage": "We could not sign you in, because the service you signed in with did not confirm your email address."
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "citsci first broker login",
      "description": "What happens the first time an Identity arrives from a source: a new Person, or the one that already holds this address.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-review-profile",
          "authenticatorConfig": "citsci-review-what-is-missing",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "citsci create a Person, or join one",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citsci create a Person, or join one",
      "description": "Create a Person, or join the one holding the address. idp-create-user-if-unique decides which.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "citsci join the Person holding this address",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citsci join the Person holding this address",
      "description": "The address already belongs to a Person. The refusal is asked before the join, so a refused Identity never reaches idp-auto-link.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "citsci refuse an unverified address",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "citsci refuse an unverified address",
      "description": "Refuses an address the arriving source did not verify. Nothing else checks it: idp-auto-link reads the address alone (issue #75).",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "citsci-condition-unverified-email",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "deny-access-authenticator",
          "authenticatorConfig": "citsci-refuse-an-unverified-join",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "clientProfiles": {
    "profiles": [
      {
        "name": "code-flow-only",
        "description": "What every client is held to, whatever its own settings say.",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": "false"
            }
          },
          {
            "executor": "reject-implicit-grant",
            "configuration": {
              "auto-configure": "false"
            }
          }
        ]
      },
      {
        "name": "nonce-where-the-id-token-reaches-a-browser",
        "description": "A nonce, from the clients whose ID token a browser can see. ADR-0016 says why that is not every client.",
        "executors": [
          {
            "executor": "secure-session",
            "configuration": {}
          }
        ]
      }
    ]
  },
  "clientPolicies": {
    "policies": [
      {
        "name": "code-flow-only",
        "description": "Applies the code-flow-only profile to every client.",
        "enabled": true,
        "conditions": [
          {
            "condition": "any-client",
            "configuration": {}
          }
        ],
        "profiles": ["code-flow-only"]
      },
      {
        "name": "nonce-where-the-id-token-reaches-a-browser",
        "description": "Public clients only: a confidential client fetches its tokens itself, over a channel no browser is on. ADR-0016.",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-access-type",
            "configuration": {
              "type": ["public"]
            }
          }
        ],
        "profiles": ["nonce-where-the-id-token-reaches-a-browser"]
      }
    ]
  }
}
